# =============================================================================
# Pick ONE backend. Both speak the OpenAI Chat Completions protocol, which is
# what Genie's LLM client expects (src/worksheets/llm/llm.py).
# =============================================================================

# ---- BACKEND A: Gemini API key (static key, no refresh) ---------------------
# Get one at https://aistudio.google.com/apikey -- create it INSIDE your Google
# Cloud project so usage bills to that project's credits.
LLM_BACKEND=gemini_api
GEMINI_API_KEY=
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHEAP_MODEL=gemini-3.1-flash-lite
STRONG_MODEL=gemini-3.5-flash-lite

# ---- BACKEND B: Vertex AI via ADC (short-lived OAuth token) -----------------
# Needs: gcloud auth application-default login
# Tokens expire ~hourly, so llm.py must refresh mid-run. Model ids take a
# "google/" prefix here, unlike Backend A.
# LLM_BACKEND=vertex
# GCP_PROJECT_ID=your-project-id
# GCP_REGION=us-central1
# CHEAP_MODEL=google/gemini-2.5-flash-lite
# STRONG_MODEL=google/gemini-2.5-pro

# ---- Pricing (USD per 1M tokens) -------------------------------------------
# From https://ai.google.dev/pricing (Backend A) or
#      https://cloud.google.com/vertex-ai/generative-ai/pricing (Backend B)
CHEAP_MODEL_USD_PER_MTOK_IN=0.25
CHEAP_MODEL_USD_PER_MTOK_OUT=1.50
STRONG_MODEL_USD_PER_MTOK_IN=0.30
STRONG_MODEL_USD_PER_MTOK_OUT=2.50
# gemini-2.5-pro only: rates above the prompt-length threshold
STRONG_MODEL_USD_PER_MTOK_IN_LONG=
STRONG_MODEL_USD_PER_MTOK_OUT_LONG=
STRONG_MODEL_LONG_PROMPT_THRESHOLD=

# ---- Budget guard ----------------------------------------------------------
MAX_RUN_USD=5

# ---- Set programmatically by src/ddx_genie/llm.py --------------------------
# Genie's client reads LLM_API_KEY; llm.py sets it from GEMINI_API_KEY
# (Backend A) or from a freshly minted ADC token (Backend B). Do not set it here.
# LLM_API_KEY=

# Paid tier measured at ~73 req/min sustained with no 429; 90 with retries is safe.
# Enable billing on the Cloud project to lift this to thousands/min (paid tier).
REQUESTS_PER_MINUTE=90
