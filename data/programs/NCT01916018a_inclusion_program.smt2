(assert (! (= patient_serum_free_triiodothyronine_within_standard_range_now (and (>= patient_serum_free_triiodothyronine_measurement_value_recorded_now_withunit_picomol_per_liter standard_range_lower_bound_free_triiodothyronine_withunit_picomol_per_liter) (<= patient_serum_free_triiodothyronine_measurement_value_recorded_now_withunit_picomol_per_liter standard_range_upper_bound_free_triiodothyronine_withunit_picomol_per_liter))) :named REQ1_AUXILIARY1))
(assert (! (= patient_has_finding_of_subclinical_hypothyroidism_now (and patient_serum_free_t4_within_standard_range_now patient_serum_free_triiodothyronine_within_standard_range_now)) :named REQ1_AUXILIARY2))
(assert (! (= patient_has_negative_perchlorate_test_now (and patient_iodine_value_recorded_inthepast2hours_withunit_percent@@measured_after_perchlorate_injection (< patient_iodine_value_recorded_inthepast2hours_withunit_percent 10.0))) :named REQ3_AUXILIARY0))
(assert (! (=> patient_iodine_value_recorded_inthepast2hours_withunit_percent@@measured_after_perchlorate_injection (and patient_is_exposed_to_perchlorate_salt_now patient_is_exposed_to_perchlorate_salt_now@@exposure_by_injection)) :named REQ3_AUXILIARY1))
(assert (! (= patient_has_self_immunity_to_thyroid_now (or patient_is_exposed_to_antithyroperoxidase_antibody_now patient_is_exposed_to_antithyroglobulin_antibody_now)) :named REQ4_AUXILIARY0))
(assert (! (= mother_has_self_immunity_to_thyroid_now (or mother_is_exposed_to_antithyroperoxidase_antibody_now mother_is_exposed_to_antithyroglobulin_antibody_now)) :named REQ4_AUXILIARY1))

;; AUTO auxiliary (qualifier => stem) links [Bool→Bool]
(assert (! (=> patient_has_finding_of_neonatal_goiter_now@@determined_by_palpation patient_has_finding_of_neonatal_goiter_now) :named AUTO_AUXILIARY_QUAL_IMPLIES_STEM_0))
