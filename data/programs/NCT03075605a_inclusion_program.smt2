;; Declarations/definitions (original + any auto-added Bool stems)
(declare-const patient_sex_is_male_now Bool)
(declare-const patient_sex_is_female_now Bool)
(declare-const patient_age_value_recorded_now_in_years Real)
(declare-const patient_body_weight_value_recorded_now_withunit_kilograms Real)
(declare-const patient_has_diagnosis_of_acute_pancreatitis_now Bool)
(declare-const patient_has_finding_of_abdominal_pain_now Bool)
(declare-const patient_has_finding_of_abdominal_localizing_signs_now Bool)
(declare-const patient_amylase_measurement_value_recorded_now_withunit_unit Real)
(declare-const amylase_upper_limit_of_normal_now_withunit_unit Real)
(declare-const patient_triacylglycerol_lipase_measurement_value_recorded_now_withunit_unit Real)
(declare-const triacylglycerol_lipase_upper_limit_of_normal_now_withunit_unit Real)
(declare-const patient_has_elevated_amylase_now Bool)
(declare-const patient_has_elevated_lipase_now Bool)
(declare-const patient_has_acute_pancreatitis_by_criteria_now Bool)
(declare-const serum_amylase_value_recorded_now_withunit_u_per_l Real)
(declare-const serum_amylase_upper_limit_of_normal_value_withunit_u_per_l Real)
(declare-const serum_lipase_value_recorded_now_withunit_u_per_l Real)
(declare-const serum_lipase_upper_limit_of_normal_value_withunit_u_per_l Real)
(declare-const patient_has_finding_of_epigastric_pain_of_acute_pancreatitis_now Bool)
(declare-const patient_has_undergone_imaging_of_abdomen_now Bool)
(declare-const patient_has_undergone_imaging_of_abdomen_now@@demonstrates_pancreatic_edema_or_peripancreatic_fat_stranding_or_complications_of_acute_pancreatitis Bool)
(declare-const patient_has_amylase_greater_than_3x_uln_now Bool)
(declare-const patient_has_lipase_greater_than_3x_uln_now Bool)
(declare-const patient_has_acute_pancreatitis_now Bool)
(declare-const patient_meets_pancreatitis_criterion1_now Bool)
(declare-const patient_meets_pancreatitis_criterion2_now Bool)
(declare-const patient_meets_pancreatitis_criterion3_now Bool)
(define-fun pancreatitis_criteria_met_count () Int (+ (ite patient_meets_pancreatitis_criterion1_now 1 0) (ite patient_meets_pancreatitis_criterion2_now 1 0) (ite patient_meets_pancreatitis_criterion3_now 1 0)))

;; Existing auxiliary assertions
(assert (! (= patient_has_elevated_amylase_now (>= patient_amylase_measurement_value_recorded_now_withunit_unit (* 3.0 amylase_upper_limit_of_normal_now_withunit_unit))) :named REQ2_AUXILIARY0))
(assert (! (= patient_has_elevated_lipase_now (>= patient_triacylglycerol_lipase_measurement_value_recorded_now_withunit_unit (* 3.0 triacylglycerol_lipase_upper_limit_of_normal_now_withunit_unit))) :named REQ2_AUXILIARY1))
(assert (! (= patient_has_acute_pancreatitis_by_criteria_now (and (or patient_has_finding_of_abdominal_pain_now patient_has_finding_of_abdominal_localizing_signs_now) (or patient_has_elevated_amylase_now patient_has_elevated_lipase_now))) :named REQ2_AUXILIARY2))
(assert (! (=> patient_has_diagnosis_of_acute_pancreatitis_now patient_has_acute_pancreatitis_by_criteria_now) :named REQ2_AUXILIARY3))
(assert (! (= patient_has_amylase_greater_than_3x_uln_now (> serum_amylase_value_recorded_now_withunit_u_per_l (* 3.0 serum_amylase_upper_limit_of_normal_value_withunit_u_per_l))) :named REQ3_AUXILIARY0))
(assert (! (= patient_has_lipase_greater_than_3x_uln_now (> serum_lipase_value_recorded_now_withunit_u_per_l (* 3.0 serum_lipase_upper_limit_of_normal_value_withunit_u_per_l))) :named REQ3_AUXILIARY1))
(assert (! (=> patient_has_amylase_greater_than_3x_uln_now patient_has_elevated_amylase_now) :named REQ3_AUXILIARY2))
(assert (! (=> patient_has_lipase_greater_than_3x_uln_now patient_has_elevated_lipase_now) :named REQ3_AUXILIARY3))
(assert (! (=> patient_has_undergone_imaging_of_abdomen_now@@demonstrates_pancreatic_edema_or_peripancreatic_fat_stranding_or_complications_of_acute_pancreatitis patient_has_undergone_imaging_of_abdomen_now) :named REQ3_AUXILIARY4))
(assert (! (= patient_meets_pancreatitis_criterion1_now (or patient_has_amylase_greater_than_3x_uln_now patient_has_lipase_greater_than_3x_uln_now)) :named REQ3_AUXILIARY5))
(assert (! (= patient_meets_pancreatitis_criterion2_now patient_has_finding_of_epigastric_pain_of_acute_pancreatitis_now) :named REQ3_AUXILIARY6))
(assert (! (= patient_meets_pancreatitis_criterion3_now patient_has_undergone_imaging_of_abdomen_now@@demonstrates_pancreatic_edema_or_peripancreatic_fat_stranding_or_complications_of_acute_pancreatitis) :named REQ3_AUXILIARY7))
(assert (! (= patient_has_acute_pancreatitis_now (>= pancreatitis_criteria_met_count 2)) :named REQ3_AUXILIARY8))

;; Other kept assertions
(assert (! (or patient_sex_is_male_now (and patient_sex_is_female_now (>= patient_age_value_recorded_now_in_years 16))) :named REQ0_COMPONENT0_PRESCREEN_NOTES_MUST_COMPLETELY_SUFFICE))
(assert (! (>= patient_body_weight_value_recorded_now_withunit_kilograms 40.0) :named REQ1_COMPONENT0_OTHER_REQUIREMENTS))
(assert (! patient_has_diagnosis_of_acute_pancreatitis_now :named REQ2_COMPONENT0_OTHER_REQUIREMENTS))
(assert (! patient_has_acute_pancreatitis_now :named REQ3_COMPONENT0_OTHER_REQUIREMENTS))
